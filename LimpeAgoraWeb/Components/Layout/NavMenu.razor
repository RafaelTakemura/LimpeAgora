@implements IDisposable
@inject AuthSessionService SessionService

<div class="top-row ps-3 navbar navbar-dark bg-dark">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" href="">LimpeAgora</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-speedometer2" aria-hidden="true"></span> Dashboard
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="pedidos">
                <span class="bi bi-bag-check" aria-hidden="true"></span> Pedidos
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="produtos">
                <span class="bi bi-box-seam" aria-hidden="true"></span> Produtos & Estoque
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="categorias">
                <span class="bi bi-tags" aria-hidden="true"></span> Categorias
            </NavLink>
        </div>

        @if (SessionService.IsAdmin)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="usuarios">
                    <span class="bi bi-people" aria-hidden="true"></span> Usuários (Admin)
                </NavLink>
            </div>
        }

        @if (!SessionService.IsAuthenticated)
        {
            <div class="nav-item px-3 mt-4">
                <NavLink class="nav-link text-warning" href="login">
                    <span class="bi bi-box-arrow-in-right" aria-hidden="true"></span> Fazer Login
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        SessionService.OnChange += OnSessionChanged;

        if (!SessionService.IsAuthenticated)
        {
            var restaurou = await SessionService.RestaurarSessaoAsync();
            if (restaurou)
            {
                StateHasChanged();
            }
        }
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        SessionService.OnChange -= OnSessionChanged;
    }
}
