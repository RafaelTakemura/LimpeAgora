<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LimpeAgoraApp.ViewModels"
             xmlns:m="clr-namespace:LimpeAgoraApp.Models"
             xmlns:dto="clr-namespace:LimpeAgora.Shared.DTOs.Pedidos;assembly=LimpeAgora.Shared"
             xmlns:enums="clr-namespace:LimpeAgora.Shared.Enums;assembly=LimpeAgora.Shared"
             x:Class="LimpeAgoraApp.Views.MeusPedidosPage"
             x:DataType="vm:MeusPedidosViewModel"
             Title="{Binding Titulo}">

    <Grid RowDefinitions="Auto, *">
        
        <!-- Banner Offline / Cache Local -->
        <Border Grid.Row="0"
                IsVisible="{Binding DadosLocaisDesatualizados}"
                BackgroundColor="#FFF3CD"
                Stroke="#FFEBAA"
                Padding="12,8">
            <Label Text="⚠️ Modo offline: exibindo histórico de pedidos em cache no SQLite."
                   TextColor="#856404"
                   FontSize="12"
                   HorizontalOptions="Center" />
        </Border>

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding CarregarPedidosCommand}">
            <ScrollView Padding="16">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Meus Pedidos"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                            <Label Text="Acompanhe o andamento dos seus pedidos para retirada"
                                   FontSize="13"
                                   TextColor="Gray" />
                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                                Text="Sair"
                                Command="{Binding LogoutCommand}"
                                BackgroundColor="#FFEBEE"
                                TextColor="#C62828"
                                FontSize="12"
                                HeightRequest="36"
                                CornerRadius="6"
                                VerticalOptions="Center" />
                    </Grid>

                    <CollectionView ItemsSource="{Binding Pedidos}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="m:PedidoLocal">
                                <Border StrokeShape="RoundRectangle 12"
                                        StrokeThickness="1"
                                        Stroke="#E0E0E0"
                                        BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                                        Padding="16"
                                        Margin="0,0,0,12">
                                    <VerticalStackLayout Spacing="8">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <Label Text="{Binding DataPedido, StringFormat='Data: {0:dd/MM/yyyy HH:mm}'}"
                                                       FontSize="13"
                                                       FontAttributes="Bold" />
                                                <Label Text="{Binding Id, StringFormat='Pedido #{0}'}"
                                                       FontSize="11"
                                                       TextColor="Gray" />
                                            </VerticalStackLayout>

                                            <!-- Badge de Status -->
                                            <Border Grid.Column="1"
                                                    StrokeShape="RoundRectangle 6"
                                                    BackgroundColor="{StaticResource Primary}"
                                                    Padding="8,4">
                                                <Label Text="{Binding StatusDescricao}"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="White" />
                                            </Border>
                                        </Grid>

                                        <BoxView HeightRequest="1" Color="#EEEEEE" />

                                        <Grid ColumnDefinitions="*, Auto">
                                            <Label Grid.Column="0"
                                                   Text="{Binding TotalItens, StringFormat='Total de itens: {0} un.'}"
                                                   FontSize="13"
                                                   VerticalOptions="Center"
                                                   TextColor="Gray" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding ValorTotal, StringFormat='{0:C}'}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Primary}" />
                                        </Grid>

                                        <!-- Botões de Ação do Pedido -->
                                        <HorizontalStackLayout Spacing="8" HorizontalOptions="End" Margin="0,4,0,0">
                                            <Button Text="Ver Detalhes"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MeusPedidosViewModel}}, Path=VerDetalhesCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#1565C0}"
                                                    TextColor="{AppThemeBinding Light=#1565C0, Dark=White}"
                                                    FontSize="12"
                                                    HeightRequest="36"
                                                    CornerRadius="6" />

                                            <Button Text="Cancelar"
                                                    IsVisible="{Binding Status, Converter={StaticResource StatusPendenteConverter}}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MeusPedidosViewModel}}, Path=CancelarPedidoCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#FFEBEE"
                                                    TextColor="#C62828"
                                                    FontSize="12"
                                                    HeightRequest="36"
                                                    CornerRadius="6" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Modal de Detalhes do Pedido Selecionado -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              IsVisible="{Binding ModalDetalhesAberto}"
              BackgroundColor="#80000000">
            <Border StrokeShape="RoundRectangle 16"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                    Margin="20,40"
                    Padding="20"
                    VerticalOptions="Center">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0"
                               Text="Detalhes do Pedido"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />
                        <Button Grid.Column="1"
                                Text="✕"
                                Command="{Binding FecharModalDetalhesCommand}"
                                Background="Transparent"
                                TextColor="Gray"
                                FontSize="16" />
                    </Grid>

                    <Label Text="Retirada presencial e pagamento à vista no balcão da loja"
                           FontSize="12"
                           TextColor="Gray" />

                    <!-- Lista de Itens Comprados (Imutáveis) -->
                    <ScrollView MaximumHeightRequest="220">
                        <CollectionView ItemsSource="{Binding PedidoDetalheSelecionado.Itens}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="dto:ItemPedidoResponse">
                                    <Grid ColumnDefinitions="*, Auto" Padding="0,4">
                                        <VerticalStackLayout Grid.Column="0">
                                            <Label Text="{Binding NomeProduto}" FontSize="13" FontAttributes="Bold" />
                                            <Label Text="{Binding Quantidade, StringFormat='Qtd: {0} un.'}" FontSize="11" TextColor="Gray" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1"
                                               Text="{Binding Subtotal, StringFormat='{0:C}'}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </ScrollView>

                    <BoxView HeightRequest="1" Color="#EEEEEE" />

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="Valor Total:" FontAttributes="Bold" FontSize="15" />
                        <Label Grid.Column="1"
                               Text="{Binding PedidoDetalheSelecionado.ValorTotal, StringFormat='{0:C}'}"
                               FontAttributes="Bold"
                               FontSize="17"
                               TextColor="{StaticResource Primary}" />
                    </Grid>

                    <Button Text="Fechar"
                            Command="{Binding FecharModalDetalhesCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="42" />
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
