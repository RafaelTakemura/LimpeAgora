<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LimpeAgoraApp.ViewModels"
             xmlns:m="clr-namespace:LimpeAgoraApp.Models"
             x:Class="LimpeAgoraApp.Views.CategoriasPage"
             x:DataType="vm:CategoriasViewModel"
             Title="{Binding Titulo}">

    <Grid RowDefinitions="Auto, *">
        
        <!-- Banner Offline / Cache Local -->
        <Border Grid.Row="0"
                IsVisible="{Binding DadosLocaisDesatualizados}"
                BackgroundColor="#FFF3CD"
                Stroke="#FFEBAA"
                Padding="12,8">
            <Label Text="⚠️ Modo offline: exibindo categorias armazenadas localmente no SQLite."
                   TextColor="#856404"
                   FontSize="12"
                   HorizontalOptions="Center" />
        </Border>

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding CarregarCategoriasCommand}">
            <ScrollView Padding="16">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Escolha uma Categoria"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />
                    <Label Text="Toque em uma categoria para visualizar seus produtos disponíveis"
                           FontSize="13"
                           TextColor="Gray" />

                    <CollectionView ItemsSource="{Binding Categorias}"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="m:CategoriaLocal">
                                <Border StrokeShape="RoundRectangle 12"
                                        StrokeThickness="1"
                                        Stroke="{StaticResource PrimaryBrush}"
                                        BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                                        Padding="16"
                                        Margin="0,0,0,12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CategoriasViewModel}}, Path=SelecionarCategoriaCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    
                                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                                            <Label Text="{Binding Nome}"
                                                   FontSize="18"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Primary}" />
                                            <Label Text="{Binding Descricao}"
                                                   FontSize="13"
                                                   TextColor="Gray"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="2" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1"
                                               Text="➔"
                                               FontSize="20"
                                               TextColor="{StaticResource Primary}"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

    </Grid>
</ContentPage>
