<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LimpeAgoraApp.ViewModels"
             x:Class="LimpeAgoraApp.Views.CadastroPage"
             x:DataType="vm:CadastroViewModel"
             Title="{Binding Titulo}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            
            <Label Text="Crie sua Conta"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Primary}" />
            <Label Text="Cadastre-se para montar e acompanhar seus pedidos"
                   FontSize="13"
                   TextColor="Gray" />

            <!-- Alerta de Erro -->
            <Border IsVisible="{Binding MensagemErro, Converter={StaticResource StringToBooleanConverter}}"
                    BackgroundColor="#FFEBEE"
                    Stroke="#E53935"
                    Padding="12"
                    StrokeShape="RoundRectangle 8">
                <Label Text="{Binding MensagemErro}" TextColor="#C62828" FontSize="13" />
            </Border>

            <VerticalStackLayout Spacing="4">
                <Label Text="Nome Completo *" FontSize="13" FontAttributes="Bold" />
                <Entry Placeholder="Ex: Maria da Silva" Text="{Binding NomeCompleto}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="E-mail *" FontSize="13" FontAttributes="Bold" />
                <Entry Placeholder="nome@exemplo.com" Keyboard="Email" Text="{Binding Email}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Telefone *" FontSize="13" FontAttributes="Bold" />
                <Entry Placeholder="(00) 00000-0000" Keyboard="Telephone" Text="{Binding Telefone}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Senha *" FontSize="13" FontAttributes="Bold" />
                <Entry Placeholder="Mínimo 6 caracteres" IsPassword="True" Text="{Binding Senha}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Confirmar Senha *" FontSize="13" FontAttributes="Bold" />
                <Entry Placeholder="Repita sua senha" IsPassword="True" Text="{Binding ConfirmarSenha}" />
            </VerticalStackLayout>

            <Button Text="Cadastrar Conta"
                    Command="{Binding CadastrarCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="48"
                    Margin="0,16,0,0" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />

            <Button Text="Já tenho uma conta. Voltar ao Login"
                    Command="{Binding VoltarAoLoginCommand}"
                    Background="Transparent"
                    TextColor="{StaticResource Primary}"
                    HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
