<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LimpeAgoraApp.ViewModels"
             x:Class="LimpeAgoraApp.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="{Binding Titulo}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BrandBackground}">

    <ScrollView VerticalScrollBarVisibility="Never" Padding="0,16">
        <VerticalStackLayout Spacing="0"
                             WidthRequest="340"
                             HorizontalOptions="Center">

            <!-- ============================================== -->
            <!-- TOPO: Mascote Ninja + Identidade Visual LimpeAgora -->
            <!-- ============================================== -->
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center" WidthRequest="340">
                
                <!-- Avatar Circular em Destaque com Mascote Oficial -->
                <Border StrokeShape="RoundRectangle 50"
                        Stroke="{StaticResource BrandCyanBrush}"
                        StrokeThickness="2.5"
                        WidthRequest="100"
                        HeightRequest="100"
                        HorizontalOptions="Center"
                        BackgroundColor="White">
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource BrandCyanBrush}"
                                Opacity="0.25"
                                Radius="14"
                                Offset="0,4" />
                    </Border.Shadow>
                    
                    <Image Source="mascote_avatar.png"
                           Aspect="AspectFill"
                           WidthRequest="100"
                           HeightRequest="100" />
                </Border>

                <!-- Nome do Aplicativo -->
                <Label Text="LimpeAgora"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="{StaticResource BrandBlue}"
                       HorizontalOptions="Center"
                       Margin="0,2,0,0" />

                <!-- Selo de Propósito / Boas-vindas -->
                <Border StrokeShape="RoundRectangle 14"
                        BackgroundColor="{StaticResource BrandCyanLight}"
                        Stroke="{StaticResource BrandCyanBrush}"
                        StrokeThickness="1"
                        Padding="12,4"
                        HorizontalOptions="Center">
                    <Label Text="✨ Produtos de limpeza para retirada rápida"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{StaticResource BrandCyan}"
                           HorizontalOptions="Center" />
                </Border>
            </VerticalStackLayout>

            <!-- ============================================== -->
            <!-- CARD CENTRAL: Formulário de Autenticação        -->
            <!-- ============================================== -->
            <Border StrokeShape="RoundRectangle 22"
                    Stroke="{StaticResource BrandBorderBrush}"
                    StrokeThickness="1"
                    Padding="20,20"
                    BackgroundColor="{StaticResource BrandSurface}"
                    WidthRequest="340"
                    HorizontalOptions="Center"
                    Margin="0,14,0,0">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource Gray400Brush}"
                            Opacity="0.12"
                            Radius="16"
                            Offset="0,6" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="13">
                    
                    <!-- Saudação Amigável -->
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Bem-vindo(a)! 👋"
                               FontSize="19"
                               FontAttributes="Bold"
                               TextColor="{StaticResource BrandTextPrimary}" />
                        <Label Text="Acesse com sua conta para continuar"
                               FontSize="12"
                               TextColor="{StaticResource BrandTextSecondary}" />
                    </VerticalStackLayout>

                    <!-- Alerta de Erro com Ícone e Destaque Visual -->
                    <Border IsVisible="{Binding MensagemErro, Converter={StaticResource StringToBooleanConverter}}"
                            BackgroundColor="#FEF2F2"
                            Stroke="#FCA5A5"
                            StrokeThickness="1"
                            Padding="12,8"
                            StrokeShape="RoundRectangle 12">
                        <Grid ColumnDefinitions="22, *" ColumnSpacing="8" VerticalOptions="Center">
                            <Label Grid.Column="0"
                                   Text="⚠️"
                                   FontSize="14"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding MensagemErro}"
                                   TextColor="#DC2626"
                                   FontSize="12"
                                   VerticalOptions="Center"
                                   LineBreakMode="WordWrap" />
                        </Grid>
                    </Border>

                    <!-- Campo: E-mail -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="E-mail"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource BrandTextPrimary}" />
                        
                        <Border StrokeShape="RoundRectangle 14"
                                Stroke="{StaticResource BrandBorderBrush}"
                                StrokeThickness="1.5"
                                BackgroundColor="#F8FAFC"
                                Padding="12,0"
                                HeightRequest="48"
                                HorizontalOptions="Fill">
                            <Grid ColumnDefinitions="24, *" ColumnSpacing="8" VerticalOptions="Center">
                                <Label Grid.Column="0"
                                       Text="✉️"
                                       FontSize="13"
                                       VerticalOptions="Center" />
                                <Entry Grid.Column="1"
                                       Placeholder="seu@email.com"
                                       Keyboard="Email"
                                       Text="{Binding Email}"
                                       FontSize="13"
                                       TextColor="{StaticResource BrandTextPrimary}"
                                       PlaceholderColor="{StaticResource Gray400}"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Fill"
                                       ClearButtonVisibility="WhileEditing" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Campo: Senha -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Senha"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource BrandTextPrimary}" />
                        
                        <Border StrokeShape="RoundRectangle 14"
                                Stroke="{StaticResource BrandBorderBrush}"
                                StrokeThickness="1.5"
                                BackgroundColor="#F8FAFC"
                                Padding="12,0"
                                HeightRequest="48"
                                HorizontalOptions="Fill">
                            <Grid ColumnDefinitions="24, *" ColumnSpacing="8" VerticalOptions="Center">
                                <Label Grid.Column="0"
                                       Text="🔒"
                                       FontSize="13"
                                       VerticalOptions="Center" />
                                <Entry Grid.Column="1"
                                       Placeholder="Sua senha de acesso"
                                       IsPassword="True"
                                       Text="{Binding Senha}"
                                       FontSize="13"
                                       TextColor="{StaticResource BrandTextPrimary}"
                                       PlaceholderColor="{StaticResource Gray400}"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Fill" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Botão Entrar em Destaque (Azul Royal Ninja) -->
                    <Button Text="Entrar"
                            Command="{Binding RealizarLoginCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                            BackgroundColor="{StaticResource BrandBlue}"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="15"
                            CornerRadius="14"
                            HeightRequest="48"
                            Margin="0,4,0,0">
                        <Button.Shadow>
                            <Shadow Brush="{StaticResource BrandBlueBrush}"
                                    Opacity="0.28"
                                    Radius="12"
                                    Offset="0,4" />
                        </Button.Shadow>
                    </Button>

                    <!-- Indicador de Carregamento -->
                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource BrandBlue}"
                                       HeightRequest="32"
                                       HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- ============================================== -->
            <!-- RODAPÉ: Acesso a Cadastro e Diferenciais       -->
            <!-- ============================================== -->
            <Border StrokeShape="RoundRectangle 16"
                    BackgroundColor="{StaticResource BrandSurface}"
                    Stroke="{StaticResource BrandBorderBrush}"
                    StrokeThickness="1"
                    Padding="14,10"
                    WidthRequest="340"
                    HorizontalOptions="Center"
                    Margin="0,12,0,0">
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                    <Label Text="Não tem uma conta?"
                           TextColor="{StaticResource BrandTextSecondary}"
                           FontSize="13"
                           VerticalOptions="Center" />
                    <Button Text="Cadastre-se aqui"
                            Command="{Binding IrParaCadastroCommand}"
                            Background="Transparent"
                            TextColor="{StaticResource BrandGreen}"
                            FontAttributes="Bold"
                            FontSize="13"
                            Padding="0"
                            HeightRequest="32"
                            VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- Badges de Confiabilidade / Freshness -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="16" Margin="0,12,0,16">
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Label Text="⚡" FontSize="12" VerticalOptions="Center" />
                    <Label Text="Retirada Expressa"
                           FontSize="11"
                           TextColor="{StaticResource BrandTextSecondary}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
                
                <BoxView WidthRequest="1"
                         HeightRequest="12"
                         BackgroundColor="{StaticResource BrandBorder}"
                         VerticalOptions="Center" />
                
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Label Text="🛡️" FontSize="12" VerticalOptions="Center" />
                    <Label Text="Compra Segura"
                           FontSize="11"
                           TextColor="{StaticResource BrandTextSecondary}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
