<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LimpeAgoraApp.ViewModels"
             xmlns:m="clr-namespace:LimpeAgoraApp.Models"
             xmlns:dto="clr-namespace:LimpeAgora.Shared.DTOs.Pedidos;assembly=LimpeAgora.Shared"
             xmlns:enums="clr-namespace:LimpeAgora.Shared.Enums;assembly=LimpeAgora.Shared"
             x:Class="LimpeAgoraApp.Views.MeusPedidosPage"
             x:DataType="vm:MeusPedidosViewModel"
             Title="{Binding Titulo}"
             BackgroundColor="{StaticResource BrandBackground}">

    <Grid RowDefinitions="Auto, *">
        
        <!-- ============================================== -->
        <!-- BANNER OFFLINE / CACHE LOCAL ESTILIZADO        -->
        <!-- ============================================== -->
        <Border Grid.Row="0"
                IsVisible="{Binding DadosLocaisDesatualizados}"
                BackgroundColor="#FEF3C7"
                Stroke="#FCD34D"
                StrokeThickness="1"
                Padding="14,10"
                Margin="16,8,16,0"
                StrokeShape="RoundRectangle 12">
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                <Label Text="⚠️" FontSize="14" VerticalOptions="Center" />
                <Label Text="Modo offline: exibindo pedidos em cache local no SQLite."
                       TextColor="#92400E"
                       FontSize="12"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

        <!-- ============================================== -->
        <!-- LISTA DE PEDIDOS COM PULL-TO-REFRESH           -->
        <!-- ============================================== -->
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding CarregarPedidosCommand}"
                     RefreshColor="{StaticResource BrandBlue}">
            <ScrollView Padding="16,14">
                <VerticalStackLayout Spacing="16" MaximumWidthRequest="460" HorizontalOptions="Center">
                    
                    <!-- Cabeçalho com Título e Botão de Logout -->
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Meus Pedidos"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource BrandBlue}" />
                            <Label Text="Acompanhe o status e histórico de compras para retirada"
                                   FontSize="12"
                                   TextColor="{StaticResource BrandTextSecondary}" />
                        </VerticalStackLayout>

                        <!-- Botão Sair da Conta -->
                        <Button Grid.Column="1"
                                Text="Sair"
                                Command="{Binding LogoutCommand}"
                                BackgroundColor="#FEE2E2"
                                TextColor="#DC2626"
                                FontSize="12"
                                FontAttributes="Bold"
                                HeightRequest="36"
                                Padding="12,0"
                                CornerRadius="10"
                                VerticalOptions="Center" />
                    </Grid>

                    <!-- Lista de Pedidos -->
                    <CollectionView ItemsSource="{Binding Pedidos}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="m:PedidoLocal">
                                <Border StrokeShape="RoundRectangle 18"
                                        StrokeThickness="1"
                                        Stroke="{StaticResource BrandBorderBrush}"
                                        BackgroundColor="{StaticResource BrandSurface}"
                                        Padding="16"
                                        Margin="0,0,0,12">
                                    <Border.Shadow>
                                        <Shadow Brush="{StaticResource Gray400Brush}"
                                                Opacity="0.08"
                                                Radius="14"
                                                Offset="0,4" />
                                    </Border.Shadow>
                                    
                                    <VerticalStackLayout Spacing="10">
                                        
                                        <!-- Linha Superior: Pedido #ID e Badge de Status com Cor por Estado -->
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12" VerticalOptions="Center">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding DataPedido, StringFormat='📅 {0:dd/MM/yyyy HH:mm}'}"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource BrandTextPrimary}" />
                                                <Label Text="{Binding Id, StringFormat='Pedido #{0}'}"
                                                       FontSize="11"
                                                       TextColor="{StaticResource BrandTextSecondary}"
                                                       LineBreakMode="MiddleTruncation"
                                                       MaxLines="1" />
                                            </VerticalStackLayout>

                                            <!-- Badge de Status do Pedido com Cor Distinta por Estado -->
                                            <Border Grid.Column="1"
                                                    StrokeShape="RoundRectangle 12"
                                                    BackgroundColor="{Binding Status, Converter={StaticResource StatusToBgColorConverter}}"
                                                    Stroke="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                                    StrokeThickness="1.2"
                                                    Padding="12,5"
                                                    VerticalOptions="Center"
                                                    HorizontalOptions="End">
                                                <Label Text="{Binding StatusDescricao}"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalTextAlignment="Center"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>
                                        </Grid>

                                        <!-- Divisor Sutil -->
                                        <BoxView HeightRequest="1" Color="{StaticResource BrandBorder}" />

                                        <!-- Linha Intermediária: Qtd Itens e Valor Total -->
                                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                            <HorizontalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                                <Label Text="📦" FontSize="13" VerticalOptions="Center" />
                                                <Label Text="{Binding TotalItens, StringFormat='{0} itens no pedido'}"
                                                       FontSize="12"
                                                       TextColor="{StaticResource BrandTextSecondary}"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                            
                                            <Label Grid.Column="1"
                                                   Text="{Binding ValorTotal, StringFormat='{0:C}'}"
                                                   FontSize="17"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource BrandBlue}" />
                                        </Grid>

                                        <!-- Linha Inferior: Ações do Pedido -->
                                        <HorizontalStackLayout Spacing="8" HorizontalOptions="End" Margin="0,4,0,0">
                                            
                                            <!-- Ver Detalhes -->
                                            <Button Text="Ver Detalhes"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MeusPedidosViewModel}}, Path=VerDetalhesCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="{StaticResource BrandBlueLight}"
                                                    TextColor="{StaticResource BrandBlue}"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    HeightRequest="36"
                                                    Padding="14,0"
                                                    CornerRadius="10" />

                                            <!-- Cancelar Pedido (visível apenas para pendentes) -->
                                            <Button Text="Cancelar"
                                                    IsVisible="{Binding Status, Converter={StaticResource StatusPendenteConverter}}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MeusPedidosViewModel}}, Path=CancelarPedidoCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#FEE2E2"
                                                    TextColor="#DC2626"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    HeightRequest="36"
                                                    Padding="12,0"
                                                    CornerRadius="10" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- ============================================== -->
        <!-- MODAL DE DETALHES DO PEDIDO SELECIONADO        -->
        <!-- ============================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              IsVisible="{Binding ModalDetalhesAberto}"
              BackgroundColor="#80000000"
              Padding="16,20">
            
            <Border StrokeShape="RoundRectangle 24"
                    BackgroundColor="{StaticResource BrandSurface}"
                    Padding="20"
                    VerticalOptions="Center"
                    MaximumHeightRequest="680"
                    MaximumWidthRequest="440"
                    HorizontalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource Gray950Brush}"
                            Opacity="0.25"
                            Radius="24"
                            Offset="0,10" />
                </Border.Shadow>
                
                <VerticalStackLayout Spacing="14">
                    
                    <!-- Cabeçalho do Modal -->
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                            <Label Text="📋" FontSize="20" VerticalOptions="Center" />
                            <Label Text="Detalhes do Pedido"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource BrandBlue}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        
                        <!-- Botão Fechar Modal (✕) -->
                        <Button Grid.Column="1"
                                Text="✕"
                                Command="{Binding FecharModalDetalhesCommand}"
                                Background="Transparent"
                                TextColor="{StaticResource BrandTextSecondary}"
                                FontSize="18"
                                WidthRequest="36"
                                HeightRequest="36"
                                Padding="0" />
                    </Grid>

                    <Label Text="Retirada presencial e pagamento à vista no balcão da loja física."
                           FontSize="12"
                           TextColor="{StaticResource BrandTextSecondary}" />

                    <!-- Lista de Itens Comprados (Rolável) -->
                    <ScrollView MaximumHeightRequest="240">
                        <CollectionView ItemsSource="{Binding PedidoDetalheSelecionado.Itens}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="dto:ItemPedidoResponse">
                                    <Border StrokeShape="RoundRectangle 10"
                                            Stroke="{StaticResource BrandBorderBrush}"
                                            StrokeThickness="1"
                                            BackgroundColor="#F8FAFC"
                                            Padding="12,8"
                                            Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <Label Text="{Binding NomeProduto}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource BrandTextPrimary}" />
                                                <Label Text="{Binding Quantidade, StringFormat='Qtd: {0} un.'}"
                                                       FontSize="11"
                                                       TextColor="{StaticResource BrandTextSecondary}" />
                                            </VerticalStackLayout>
                                            
                                            <Label Grid.Column="1"
                                                   Text="{Binding Subtotal, StringFormat='{0:C}'}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource BrandBlue}"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </ScrollView>

                    <!-- Resumo do Total -->
                    <Border StrokeShape="RoundRectangle 14"
                            BackgroundColor="{StaticResource BrandBlueLight}"
                            Stroke="{StaticResource BrandBorderBrush}"
                            StrokeThickness="1"
                            Padding="14,10">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <Label Grid.Column="0"
                                   Text="Valor Total a Pagar:"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   TextColor="{StaticResource BrandBlue}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding PedidoDetalheSelecionado.ValorTotal, StringFormat='{0:C}'}"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   TextColor="{StaticResource BrandBlue}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Botão Fechar -->
                    <Button Text="Fechar"
                            Command="{Binding FecharModalDetalhesCommand}"
                            BackgroundColor="{StaticResource BrandBlue}"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="14"
                            CornerRadius="14"
                            HeightRequest="46">
                        <Button.Shadow>
                            <Shadow Brush="{StaticResource BrandBlueBrush}"
                                    Opacity="0.25"
                                    Radius="10"
                                    Offset="0,4" />
                        </Button.Shadow>
                    </Button>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
