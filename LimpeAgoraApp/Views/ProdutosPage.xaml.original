<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LimpeAgoraApp.ViewModels"
             xmlns:m="clr-namespace:LimpeAgoraApp.Models"
             x:Class="LimpeAgoraApp.Views.ProdutosPage"
             x:DataType="vm:ProdutosViewModel"
             Title="{Binding Titulo}">

    <Grid RowDefinitions="Auto, *, Auto">
        
        <!-- Banner Offline / Cache Local -->
        <Border Grid.Row="0"
                IsVisible="{Binding DadosLocaisDesatualizados}"
                BackgroundColor="#FFF3CD"
                Stroke="#FFEBAA"
                Padding="12,8">
            <Label Text="⚠️ Modo offline: exibindo produtos armazenados localmente no SQLite."
                   TextColor="#856404"
                   FontSize="12"
                   HorizontalOptions="Center" />
        </Border>

        <!-- Lista de Produtos -->
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding CarregarProdutosCommand}">
            <ScrollView Padding="16">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Catálogo de Produtos"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />
                    <Label Text="Escolha os produtos e monte seu pedido para retirada presencial"
                           FontSize="13"
                           TextColor="Gray" />

                    <CollectionView ItemsSource="{Binding Produtos}"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="m:ProdutoLocal">
                                <Border StrokeShape="RoundRectangle 12"
                                        StrokeThickness="1"
                                        Stroke="#E0E0E0"
                                        BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                                        Padding="16"
                                        Margin="0,0,0,12">
                                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto">
                                        
                                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding Nome}"
                                                   FontSize="16"
                                                   FontAttributes="Bold" />
                                            <Label Text="{Binding Apresentacao}"
                                                   FontSize="12"
                                                   TextColor="{StaticResource Primary}"
                                                   FontAttributes="Bold" />
                                        </VerticalStackLayout>

                                        <Label Grid.Row="0" Grid.Column="1"
                                               Text="{Binding Preco, StringFormat='{0:C}'}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Primary}"
                                               HorizontalOptions="End" />

                                        <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                               Text="{Binding Descricao}"
                                               FontSize="12"
                                               TextColor="Gray"
                                               Margin="0,4,0,8" />

                                        <!-- Estoque e Seletor de Quantidade: - (qtd) + -->
                                        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                                            <HorizontalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="6">
                                                <Label Text="Disponível:" FontSize="12" TextColor="Gray" VerticalOptions="Center" />
                                                <Label Text="{Binding QuantidadeEstoque, StringFormat='{0} un.'}"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#2E7D32, Dark=#81C784}"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>

                                            <!-- Seletor: - (qtd) + -->
                                            <Border Grid.Column="1"
                                                    StrokeShape="RoundRectangle 8"
                                                    Stroke="#B0BEC5"
                                                    StrokeThickness="1"
                                                    BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#37474F}"
                                                    Padding="0">
                                                <HorizontalStackLayout Spacing="0" VerticalOptions="Center">
                                                    <Button Text="-"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProdutosViewModel}}, Path=DecrementarProdutoCommand}"
                                                            CommandParameter="{Binding .}"
                                                            WidthRequest="36"
                                                            HeightRequest="36"
                                                            Padding="0"
                                                            FontSize="18"
                                                            FontAttributes="Bold"
                                                            BackgroundColor="Transparent"
                                                            TextColor="{AppThemeBinding Light=#263238, Dark=#ECEFF1}"
                                                            CornerRadius="0" />

                                                    <Border WidthRequest="40"
                                                            HeightRequest="36"
                                                            Stroke="#CFD8DC"
                                                            StrokeThickness="1"
                                                            BackgroundColor="{AppThemeBinding Light=White, Dark=#263238}">
                                                        <Label Text="{Binding QuantidadeNoCarrinho}"
                                                               VerticalOptions="Center"
                                                               HorizontalOptions="Center"
                                                               FontSize="14"
                                                               FontAttributes="Bold"
                                                               TextColor="{StaticResource Primary}" />
                                                    </Border>

                                                    <Button Text="+"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProdutosViewModel}}, Path=IncrementarProdutoCommand}"
                                                            CommandParameter="{Binding .}"
                                                            WidthRequest="36"
                                                            HeightRequest="36"
                                                            Padding="0"
                                                            FontSize="18"
                                                            FontAttributes="Bold"
                                                            BackgroundColor="{StaticResource Primary}"
                                                            TextColor="White"
                                                            CornerRadius="0" />
                                                </HorizontalStackLayout>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Barra Inferior do Pedido em Montagem (Carrinho) -->
        <Border Grid.Row="2"
                IsVisible="{Binding TotalItensCarrinho, Converter={StaticResource IntToBooleanConverter}}"
                BackgroundColor="{StaticResource Primary}"
                Padding="16,12"
                StrokeShape="RoundRectangle 16, 16, 0, 0">
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                    <Label Text="{Binding TotalItensCarrinho, StringFormat='Pedido em montagem: {0} itens'}"
                           TextColor="White"
                           FontSize="13" />
                    <Label Text="{Binding ValorTotalCarrinho, StringFormat='Total: {0:C}'}"
                           TextColor="White"
                           FontSize="18"
                           FontAttributes="Bold" />
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        Text="Revisar Pedido"
                        Command="{Binding AbrirModalCarrinhoCommand}"
                        BackgroundColor="White"
                        TextColor="{StaticResource Primary}"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Modal de Revisão do Pedido -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              IsVisible="{Binding ModalCarrinhoAberto}"
              BackgroundColor="#80000000"
              Padding="16,20">
            
            <Border StrokeShape="RoundRectangle 16"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                    Padding="16"
                    VerticalOptions="Center"
                    MaximumHeightRequest="720">
                
                <ScrollView VerticalScrollBarVisibility="Always">
                    <VerticalStackLayout Spacing="14">
                        
                        <!-- 1. Cabeçalho -->
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0"
                                   Text="Revisar Pedido"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                            <Button Grid.Column="1"
                                    Text="✕"
                                    Command="{Binding FecharModalCarrinhoCommand}"
                                    Background="Transparent"
                                    TextColor="Gray"
                                    FontSize="18"
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    Padding="0" />
                        </Grid>
                        
                        <Label Text="Retirada presencial na loja com pagamento à vista no balcão."
                               FontSize="12"
                               TextColor="Gray" />

                        <!-- 2. Lista de Itens do Pedido com altura fixa explícita e rolagem -->
                        <CollectionView ItemsSource="{Binding ItensCarrinho}"
                                        HeightRequest="240"
                                        SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="m:ItemCarrinho">
                                    <Border StrokeShape="RoundRectangle 8"
                                            Stroke="#E0E0E0"
                                            StrokeThickness="1"
                                            BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#333333}"
                                            Padding="10,8"
                                            Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="6">
                                            
                                            <!-- Nome, detalhes e subtotal -->
                                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                                                <Label Text="{Binding NomeProduto}" FontAttributes="Bold" FontSize="13" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding Apresentacao}" FontSize="11" TextColor="Gray" />
                                                <Label Text="{Binding Subtotal, StringFormat='Subtotal: {0:C}'}"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource Primary}" />
                                            </VerticalStackLayout>

                                            <!-- Seletor no Carrinho: - [ qtd ] + -->
                                            <Border Grid.Column="1"
                                                    StrokeShape="RoundRectangle 6"
                                                    Stroke="#CCCCCC"
                                                    StrokeThickness="1"
                                                    BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#37474F}"
                                                    VerticalOptions="Center"
                                                    Padding="0">
                                                <HorizontalStackLayout Spacing="0" VerticalOptions="Center">
                                                    <Button Text="-"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProdutosViewModel}}, Path=DecrementarItemCarrinhoCommand}"
                                                            CommandParameter="{Binding .}"
                                                            WidthRequest="28"
                                                            HeightRequest="28"
                                                            Padding="0"
                                                            FontSize="15"
                                                            FontAttributes="Bold"
                                                            BackgroundColor="Transparent"
                                                            TextColor="{AppThemeBinding Light=#263238, Dark=#ECEFF1}"
                                                            CornerRadius="0" />

                                                    <Border WidthRequest="32"
                                                            HeightRequest="28"
                                                            Stroke="#E0E0E0"
                                                            StrokeThickness="1"
                                                            BackgroundColor="{AppThemeBinding Light=White, Dark=#263238}">
                                                        <Label Text="{Binding Quantidade}"
                                                               VerticalOptions="Center"
                                                               HorizontalOptions="Center"
                                                               FontSize="13"
                                                               FontAttributes="Bold"
                                                               TextColor="{StaticResource Primary}" />
                                                    </Border>

                                                    <Button Text="+"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProdutosViewModel}}, Path=IncrementarItemCarrinhoCommand}"
                                                            CommandParameter="{Binding .}"
                                                            WidthRequest="28"
                                                            HeightRequest="28"
                                                            Padding="0"
                                                            FontSize="15"
                                                            FontAttributes="Bold"
                                                            BackgroundColor="{StaticResource Primary}"
                                                            TextColor="White"
                                                            CornerRadius="0" />
                                                </HorizontalStackLayout>
                                            </Border>

                                            <!-- Botão Excluir Item Inteiro (✕) -->
                                            <Button Grid.Column="2"
                                                    Text="✕"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProdutosViewModel}}, Path=RemoverDoCarrinhoCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#FFEBEE"
                                                    TextColor="#C62828"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    WidthRequest="28"
                                                    HeightRequest="28"
                                                    Padding="0"
                                                    CornerRadius="14"
                                                    VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- 3. Campo de Observação -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Observação (opcional):" FontSize="12" FontAttributes="Bold" />
                            <Entry Placeholder="Ex: Retirar por volta das 15h"
                                   Text="{Binding ObservacaoPedido}" />
                        </VerticalStackLayout>

                        <!-- 4. Total a Pagar e Botão Confirmar Pedido -->
                        <Grid ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                <Label Text="Total a Pagar na Loja:" FontSize="12" TextColor="Gray" />
                                <Label Text="{Binding ValorTotalCarrinho, StringFormat='{0:C}'}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}" />
                            </VerticalStackLayout>

                            <Button Grid.Column="1"
                                    Text="Confirmar Pedido"
                                    Command="{Binding ConfirmarPedidoCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    CornerRadius="8"
                                    HeightRequest="44"
                                    Padding="16,0"
                                    VerticalOptions="Center" />
                        </Grid>

                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                           IsVisible="{Binding IsBusy}"
                                           HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
