<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:LimpeAgoraApp"
             xmlns:conv="clr-namespace:LimpeAgoraApp.Converters"
             x:Class="LimpeAgoraApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:StringToBooleanConverter x:Key="StringToBooleanConverter" />
            <conv:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <conv:IntToBooleanConverter x:Key="IntToBooleanConverter" />
            <conv:StatusPendenteConverter x:Key="StatusPendenteConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
