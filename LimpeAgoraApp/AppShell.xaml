<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="LimpeAgoraApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:LimpeAgoraApp.Views"
    Title="LimpeAgora"
    Shell.BackgroundColor="{StaticResource BrandSurface}"
    Shell.ForegroundColor="{StaticResource BrandBlue}"
    Shell.TitleColor="{StaticResource BrandBlue}"
    Shell.TabBarBackgroundColor="{StaticResource BrandSurface}"
    Shell.TabBarForegroundColor="{StaticResource BrandBlue}"
    Shell.TabBarTitleColor="{StaticResource BrandBlue}"
    Shell.TabBarUnselectedColor="{StaticResource BrandTextSecondary}">

    <!-- Tela de Login -->
    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage" />

    <!-- Abas Principais do Cliente -->
    <TabBar Route="MainTabs">
        <Tab Title="Categorias">
            <ShellContent
                Title="Categorias"
                ContentTemplate="{DataTemplate views:CategoriasPage}"
                Route="CategoriasPage" />
        </Tab>

        <Tab Title="Produtos">
            <ShellContent
                Title="Produtos"
                ContentTemplate="{DataTemplate views:ProdutosPage}"
                Route="ProdutosPage" />
        </Tab>

        <Tab Title="Meus Pedidos">
            <ShellContent
                Title="Meus Pedidos"
                ContentTemplate="{DataTemplate views:MeusPedidosPage}"
                Route="MeusPedidosPage" />
        </Tab>
    </TabBar>

</Shell>
