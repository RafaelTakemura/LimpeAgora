<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Paleta Principal LimpeAgora (Inspirada no Mascote Ninja) -->
    <Color x:Key="Primary">#1E40AF</Color>
    <Color x:Key="PrimaryDark">#1E3A8A</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    <Color x:Key="Secondary">#22C55E</Color>
    <Color x:Key="SecondaryDarkText">#15803D</Color>
    <Color x:Key="Tertiary">#0284C7</Color>

    <!-- Tokens de Identidade Visual do Mascote -->
    <Color x:Key="BrandBlue">#1E40AF</Color>
    <Color x:Key="BrandBlueDark">#1E3A8A</Color>
    <Color x:Key="BrandBlueLight">#EFF6FF</Color>
    <Color x:Key="BrandCyan">#0284C7</Color>
    <Color x:Key="BrandCyanLight">#E0F2FE</Color>
    <Color x:Key="BrandGreen">#16A34A</Color>
    <Color x:Key="BrandGreenLight">#F0FDF4</Color>
    <Color x:Key="BrandYellow">#F59E0B</Color>
    <Color x:Key="BrandYellowLight">#FEF3C7</Color>
    <Color x:Key="BrandBackground">#F8FAFC</Color>
    <Color x:Key="BrandSurface">#FFFFFF</Color>
    <Color x:Key="BrandBorder">#E2E8F0</Color>
    <Color x:Key="BrandTextPrimary">#0F172A</Color>
    <Color x:Key="BrandTextSecondary">#64748B</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

    <!-- Pincéis da Marca LimpeAgora -->
    <SolidColorBrush x:Key="BrandBlueBrush" Color="{StaticResource BrandBlue}"/>
    <SolidColorBrush x:Key="BrandBlueLightBrush" Color="{StaticResource BrandBlueLight}"/>
    <SolidColorBrush x:Key="BrandCyanBrush" Color="{StaticResource BrandCyan}"/>
    <SolidColorBrush x:Key="BrandGreenBrush" Color="{StaticResource BrandGreen}"/>
    <SolidColorBrush x:Key="BrandGreenLightBrush" Color="{StaticResource BrandGreenLight}"/>
    <SolidColorBrush x:Key="BrandYellowBrush" Color="{StaticResource BrandYellow}"/>
    <SolidColorBrush x:Key="BrandBackgroundBrush" Color="{StaticResource BrandBackground}"/>
    <SolidColorBrush x:Key="BrandBorderBrush" Color="{StaticResource BrandBorder}"/>
</ResourceDictionary>